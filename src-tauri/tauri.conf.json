{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bandua",
  "version": "0.1.0",
  "identifier": "com.domingoolmomartin.bandua",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Bandua",
        "width": 1280,
        "height": 820,
        "minWidth": 1040,
        "minHeight": 680,
        "theme": "Dark",
        "backgroundColor": "#0d0e10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Domingo Olmo Martin",
    "copyright": "© 2026 Domingo Olmo Martin. MIT License.",
    "category": "Video",
    "shortDescription": "Déchargement de rushes avec vérification par hash",
    "longDescription": "Bandua copie les cartes caméra vers plusieurs destinations, vérifie chaque copie par hash et produit log, MHL et rapport PDF."
  }
}